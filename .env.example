# Verbindung zur PostgreSQL-Datenbank (Live-Betrieb: Hosting in der Schweiz)
DATABASE_URL=postgres://benutzer:passwort@localhost:5432/aufzugvertrag

# Verwaltungskonto: wird beim Start automatisch angelegt (Passwort mindestens 10 Zeichen)
ADMIN_EMAIL=name@example.ch
ADMIN_PASSWORT=ein-langes-passwort

# E-Mails über Resend (resend.com). Ohne Schlüssel bleibt der Versand aus, alles andere läuft.
# Schlüssel nie in den Code oder in einen Chat kopieren, nur hier bzw. in Vercel eintragen.
RESEND_API_KEY=
# Empfänger der Benachrichtigung bei jeder Buchung und jeder angenommenen Offerte
BENACHRICHTIGUNG_AN=name@example.ch
# Optional: Absender, sobald die eigene Domain bei Resend verbunden ist (sonst onboarding@resend.dev)
# MAIL_ABSENDER=Elevaris <termine@elevaris.ch>
